<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOrganization"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/screenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_margin"
        android:background="@drawable/bg_screen_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/logo_small_size"
            android:layout_height="@dimen/logo_small_size"
            android:layout_marginStart="@dimen/content_padding"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/cd_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/app_mark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/app_name"
            android:textColor="@color/primary_purple"
            android:textSize="@dimen/text_logo_small"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toEndOf="@id/imgLogo"
            app:layout_constraintTop_toTopOf="@id/imgLogo" />

        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/content_padding"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/skip"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_skip"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgLogo" />

        
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/pageDots"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:paddingStart="@dimen/content_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/content_padding"
                android:paddingBottom="16dp">

                
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/illustration"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    app:layout_constraintDimensionRatio="H,1:0.92"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.09" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.89" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.0" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.13" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.90" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.04" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gYDotStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.86" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gYDotTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.07" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBDotStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.04" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBDotTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.73" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gChipStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.38" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gChipEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.89" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gChipTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.80" />

                    
                    <View
                        android:id="@+id/blob"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_blob"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/gBlobEnd"
                        app:layout_constraintStart_toStartOf="@id/gBlobStart"
                        app:layout_constraintTop_toTopOf="@id/gBlobTop" />

                    
                    <View
                        android:id="@+id/yellowDot"
                        android:layout_width="@dimen/yellow_dot_size"
                        android:layout_height="@dimen/yellow_dot_size"
                        android:background="@drawable/bg_yellow_dot"
                        app:layout_constraintStart_toStartOf="@id/gYDotStart"
                        app:layout_constraintTop_toTopOf="@id/gYDotTop" />

                    
                    <View
                        android:id="@+id/blueDot"
                        android:layout_width="@dimen/yellow_dot_size"
                        android:layout_height="@dimen/yellow_dot_size"
                        android:background="@drawable/bg_blue_dot"
                        app:layout_constraintStart_toStartOf="@id/gBDotStart"
                        app:layout_constraintTop_toTopOf="@id/gBDotTop" />

                    
                    <LinearLayout
                        android:id="@+id/everydayCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_task_card"
                        android:elevation="@dimen/card_elevation"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding"
                        android:rotation="-4"
                        app:layout_constraintEnd_toEndOf="@id/gCardEnd"
                        app:layout_constraintStart_toStartOf="@id/gCardStart"
                        app:layout_constraintTop_toTopOf="@id/gCardTop">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/org_card_title"
                                android:textColor="@color/dark_text"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="@dimen/sparkle_size"
                                android:layout_height="@dimen/sparkle_size"
                                android:contentDescription="@string/cd_more"
                                android:src="@drawable/ic_more" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/tile_size"
                                android:layout_height="@dimen/tile_size"
                                android:background="@drawable/bg_tile_purple"
                                android:contentDescription="@string/cd_work"
                                android:padding="13dp"
                                android:src="@drawable/ic_briefcase" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/cat_work"
                                    android:textColor="@color/dark_text"
                                    android:textSize="@dimen/text_list_title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/cat_work_sub"
                                    android:textColor="@color/gray_text"
                                    android:textSize="@dimen/text_list_sub" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/tile_size"
                                android:layout_height="@dimen/tile_size"
                                android:background="@drawable/bg_tile_blue"
                                android:contentDescription="@string/cd_study"
                                android:padding="13dp"
                                android:src="@drawable/ic_graduation" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/cat_study"
                                    android:textColor="@color/dark_text"
                                    android:textSize="@dimen/text_list_title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/cat_study_sub"
                                    android:textColor="@color/gray_text"
                                    android:textSize="@dimen/text_list_sub" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/tile_size"
                                android:layout_height="@dimen/tile_size"
                                android:background="@drawable/bg_tile_orange"
                                android:contentDescription="@string/cd_life"
                                android:padding="13dp"
                                android:src="@drawable/ic_home" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/cat_life"
                                    android:textColor="@color/dark_text"
                                    android:textSize="@dimen/text_list_title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/cat_life_sub"
                                    android:textColor="@color/gray_text"
                                    android:textSize="@dimen/text_list_sub" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    
                    <LinearLayout
                        android:id="@+id/chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_purple"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:rotation="4"
                        app:layout_constraintEnd_toEndOf="@id/gChipEnd"
                        app:layout_constraintStart_toStartOf="@id/gChipStart"
                        app:layout_constraintTop_toTopOf="@id/gChipTop">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/cd_plus"
                            android:src="@drawable/ic_plus" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/org_chip"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_chip" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.04"
                    android:text="@string/org_eyebrow"
                    android:textColor="@color/primary_purple"
                    android:textSize="@dimen/text_eyebrow"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/illustration" />

                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.05"
                    android:text="@string/org_heading"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_heading"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEyebrow" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/org_desc"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/text_body"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeading" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        
        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/cd_page_indicator_1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btnGetStarted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="@dimen/dot_active_width"
                android:layout_height="@dimen/dot_size"
                android:background="@drawable/bg_dot_pill_active" />

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/dot_gap"
                android:background="@drawable/bg_dot_light" />

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/dot_gap"
                android:background="@drawable/bg_dot_light" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnGetStarted"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/content_padding"
            android:layout_marginEnd="@dimen/content_padding"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/gestureBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/get_started"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>

        
        <View
            android:id="@+id/gestureBar"
            android:layout_width="@dimen/gesture_width"
            android:layout_height="@dimen/gesture_height"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_gesture"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

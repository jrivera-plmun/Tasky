<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDeadlines"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    tools:ignore="HardcodedText">

    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/screenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_margin"
        android:background="@drawable/bg_screen_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/logo_small_size"
            android:layout_height="@dimen/logo_small_size"
            android:layout_marginStart="@dimen/content_padding"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/cd_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/app_mark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/app_name"
            android:textColor="@color/primary_purple"
            android:textSize="@dimen/text_logo_small"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toEndOf="@id/imgLogo"
            app:layout_constraintTop_toTopOf="@id/imgLogo" />

        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/content_padding"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/skip"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_skip"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgLogo" />

        
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/pageDots"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:paddingStart="@dimen/content_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/content_padding"
                android:paddingBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/illustration"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    app:layout_constraintDimensionRatio="H,1:0.85"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.19" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.90" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBlobTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.03" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.09" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.86" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gCardTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.11" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gClockEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.94" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gClockTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.0" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gDotStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.05" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gDotTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.79" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBannerStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.08" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBannerEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.84" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/gBannerTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.69" />

                    <View
                        android:id="@+id/blob"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_blob_blue"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/gBlobEnd"
                        app:layout_constraintStart_toStartOf="@id/gBlobStart"
                        app:layout_constraintTop_toTopOf="@id/gBlobTop" />

                    <View
                        android:id="@+id/blueDot"
                        android:layout_width="@dimen/yellow_dot_size"
                        android:layout_height="@dimen/yellow_dot_size"
                        android:background="@drawable/bg_blue_dot"
                        app:layout_constraintStart_toStartOf="@id/gDotStart"
                        app:layout_constraintTop_toTopOf="@id/gDotTop" />

                    
                    <LinearLayout
                        android:id="@+id/calendarCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_task_card"
                        android:elevation="@dimen/card_elevation"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="36dp"
                        android:rotation="4"
                        app:layout_constraintEnd_toEndOf="@id/gCardEnd"
                        app:layout_constraintStart_toStartOf="@id/gCardStart"
                        app:layout_constraintTop_toTopOf="@id/gCardTop">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dl_month"
                                android:textColor="@color/dark_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/cd_next_month"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_m"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_t"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_w"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_t"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_f"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_s"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/wd_s"
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="19"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="20"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="21"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="22"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="23"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="24"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="25"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="26"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="27"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1">

                                <TextView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_day_selected"
                                    android:gravity="center"
                                    android:text="28"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="29"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="30"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="31"
                                android:textColor="@color/dark_text"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/text_faded"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    
                    <ImageView
                        android:id="@+id/badgeClock"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_badge_yellow_small"
                        android:contentDescription="@string/cd_clock"
                        android:elevation="8dp"
                        android:padding="9dp"
                        android:rotation="10"
                        android:src="@drawable/ic_clock"
                        app:layout_constraintEnd_toEndOf="@id/gClockEnd"
                        app:layout_constraintTop_toTopOf="@id/gClockTop" />

                    
                    <LinearLayout
                        android:id="@+id/banner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner"
                        android:elevation="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:rotation="-4"
                        app:layout_constraintEnd_toEndOf="@id/gBannerEnd"
                        app:layout_constraintStart_toStartOf="@id/gBannerStart"
                        app:layout_constraintTop_toTopOf="@id/gBannerTop">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tile_banner"
                            android:contentDescription="@string/cd_bell"
                            android:padding="9dp"
                            android:src="@drawable/ic_bell" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/dl_banner_title"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/dl_banner_sub"
                                android:textColor="@color/light_purple"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.04"
                    android:text="@string/dl_eyebrow"
                    android:textColor="@color/primary_purple"
                    android:textSize="@dimen/text_eyebrow"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/illustration" />

                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.05"
                    android:text="@string/dl_heading"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_heading"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEyebrow" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/dl_desc"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/text_body"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeading" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        
        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/cd_page_indicator_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btnGetStarted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/dot_gap"
                android:background="@drawable/bg_dot_light" />

            <View
                android:layout_width="@dimen/dot_active_width"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/dot_gap"
                android:background="@drawable/bg_dot_pill_active" />

            <View
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginStart="@dimen/dot_gap"
                android:background="@drawable/bg_dot_light" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnGetStarted"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/content_padding"
            android:layout_marginEnd="@dimen/content_padding"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/gestureBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/get_started"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>

        
        <View
            android:id="@+id/gestureBar"
            android:layout_width="@dimen/gesture_width"
            android:layout_height="@dimen/gesture_height"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_gesture"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

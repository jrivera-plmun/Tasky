<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calendar_card"
    android:orientation="vertical"
    android:padding="20dp">

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Year"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvPickerYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="2026"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNextYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Year"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMonthJan"
                style="@style/MonthPickerItem"
                android:text="Jan" />

            <TextView
                android:id="@+id/btnMonthFeb"
                style="@style/MonthPickerItem"
                android:text="Feb" />

            <TextView
                android:id="@+id/btnMonthMar"
                style="@style/MonthPickerItem"
                android:text="Mar" />
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMonthApr"
                style="@style/MonthPickerItem"
                android:text="Apr" />

            <TextView
                android:id="@+id/btnMonthMay"
                style="@style/MonthPickerItem"
                android:text="May" />

            <TextView
                android:id="@+id/btnMonthJun"
                style="@style/MonthPickerItem"
                android:text="Jun" />
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMonthJul"
                style="@style/MonthPickerItem"
                android:text="Jul" />

            <TextView
                android:id="@+id/btnMonthAug"
                style="@style/MonthPickerItem"
                android:text="Aug" />

            <TextView
                android:id="@+id/btnMonthSep"
                style="@style/MonthPickerItem"
                android:text="Sep" />
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMonthOct"
                style="@style/MonthPickerItem"
                android:text="Oct" />

            <TextView
                android:id="@+id/btnMonthNov"
                style="@style/MonthPickerItem"
                android:text="Nov" />

            <TextView
                android:id="@+id/btnMonthDec"
                style="@style/MonthPickerItem"
                android:text="Dec" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
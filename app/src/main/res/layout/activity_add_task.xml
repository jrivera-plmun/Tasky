<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tasky_night_002">

    
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹  Tasks"
                    android:textColor="@color/tasky_night_003"
                    android:textSize="13sp"
                    android:fontFamily="sans"
                    tools:ignore="HardcodedText" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WED, OCT 28, 2026"
                    android:textColor="@color/tasky_night_004"
                    android:textSize="10sp"
                    android:fontFamily="sans"
                    tools:ignore="HardcodedText,SmallSp" />
            </LinearLayout>

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add Task"
                android:textColor="@color/tasky_night_005"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Make room for what matters. One task at a time."
                android:textColor="@color/tasky_night_004"
                android:textSize="12sp"
                android:fontFamily="sans"
                tools:ignore="HardcodedText" />

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Task title *"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/input_task_title"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="What do you need to do?"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="12sp"
                android:textColor="@color/tasky_night_005"
                android:textColorHint="#89869A"
                android:singleLine="true"
                android:fontFamily="sans"
                android:inputType="textCapSentences"
                android:importantForAutofill="no"
                tools:ignore="HardcodedText" />

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Description"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/input_task_desc"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Add a few details to help you get started..."
                android:padding="12dp"
                android:textSize="12sp"
                android:textColor="@color/tasky_night_005"
                android:textColorHint="#89869A"
                android:fontFamily="sans"
                android:inputType="textMultiLine"
                android:importantForAutofill="no"
                tools:ignore="HardcodedText" />

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Category"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/choice_school"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="✓  School"
                        android:textColor="@color/tasky_night_003"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText,SmallSp" />

                    <TextView
                        android:id="@+id/choice_work"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Work"
                        android:textColor="@color/tasky_night_004"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText,SmallSp" />

                    <TextView
                        android:id="@+id/choice_personal"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Personal"
                        android:textColor="@color/tasky_night_004"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText,SmallSp" />

                    <TextView
                        android:id="@+id/choice_family"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Family"
                        android:textColor="@color/tasky_night_004"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText,SmallSp" />

                    <TextView
                        android:id="@+id/choice_others"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Others"
                        android:textColor="@color/tasky_night_004"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText,SmallSp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="School keeps your classes and study tasks together."
                android:textColor="@color/tasky_night_004"
                android:textSize="10sp"
                tools:ignore="HardcodedText,SmallSp" />

            
            <LinearLayout
                android:id="@+id/container_subtasks_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_add_subtasks"
                    android:layout_width="110dp"
                    android:layout_height="29dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="+  Add Subtasks"
                    android:textColor="@color/tasky_night_004"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,SmallSp" />

                
                <LinearLayout
                    android:id="@+id/layout_subtasks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                
                <TextView
                    android:id="@+id/btn_add_another_subtask"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+ Add subtask"
                    android:textColor="@color/tasky_night_003"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText,SmallSp" />
            </LinearLayout>

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Priority"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/priority_option_low"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Low"
                    android:textColor="@color/tasky_night_004"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText,SmallSp" />

                <TextView
                    android:id="@+id/priority_option_medium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:text="Medium"
                    android:textColor="@color/tasky_night_003"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,SmallSp" />

                <TextView
                    android:id="@+id/priority_option_high"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="High"
                    android:textColor="@color/tasky_night_004"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText,SmallSp" />
            </LinearLayout>

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Difficulty"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/difficulty_easy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:background="@drawable/bg_chip" android:text="Easy" android:textSize="12sp" />
                <TextView android:id="@+id/difficulty_moderate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:background="@drawable/bg_chip_selected" android:text="Moderate" android:textSize="12sp" />
                <TextView android:id="@+id/difficulty_difficult" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_chip" android:text="Difficult" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="How challenging will this task be?" android:textColor="@color/tasky_night_004" android:textSize="11sp" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due date *"
                        android:textColor="@color/tasky_night_005"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="5dp">

                        <EditText
                            android:id="@+id/input_due_date"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Oct 28, 2026"
                            android:text="Oct 28, 2026"
                            android:textColor="@color/tasky_night_005"
                            android:textColorHint="#89869A"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:singleLine="true"
                            android:inputType="text"
                            android:importantForAutofill="no"
                            tools:ignore="HardcodedText,SmallSp,TextFields" />

                        <LinearLayout
                            android:id="@+id/btn_picker_due_date"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/desc_pick_due_date"
                                android:src="@drawable/ic_calendar" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="⌄"
                                android:textColor="@color/tasky_night_005"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due time *"
                        android:textColor="@color/tasky_night_005"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="5dp">

                        <EditText
                            android:id="@+id/input_due_time"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="5:00 PM"
                            android:text="5:00 PM"
                            android:textColor="@color/tasky_night_005"
                            android:textColorHint="#89869A"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:singleLine="true"
                            android:inputType="text"
                            android:importantForAutofill="no"
                            tools:ignore="HardcodedText,SmallSp,TextFields" />

                        <LinearLayout
                            android:id="@+id/btn_picker_due_time"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/desc_pick_due_time"
                                android:src="@drawable/ic_clock" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="⌄"
                                android:textColor="@color/tasky_night_005"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Estimated duration"
                android:textColor="@color/tasky_night_005"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="00       hours       ↕"
                    android:textColor="@color/tasky_night_005"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText,SmallSp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="30       minutes       ↕"
                    android:textColor="@color/tasky_night_005"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText,SmallSp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="A little estimate helps keep your workload balanced."
                android:textColor="@color/tasky_night_004"
                android:textSize="10sp"
                tools:ignore="HardcodedText,SmallSp" />

            
            <TextView
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="Save Task"
                android:textColor="@color/tasky_night_006"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            
            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/tasky_night_003"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </ScrollView>

    
    <include
        layout="@layout/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="28"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/dotsRow"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dotWork"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_work"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dotSchool"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_school"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dotPersonal"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_personal"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dotWhite"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_white"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>